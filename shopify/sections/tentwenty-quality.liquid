{{ 'tentwenty-quality.css' | asset_url | stylesheet_tag }}
{{ 'text-reveal.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

{%- liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign valid_count = 0
-%}

{%- capture slides_json -%}
[
{%- assign first_item = true -%}
{%- for block in slide_blocks -%}
  {%- if block.settings.image != blank -%}
    {%- assign valid_count = valid_count | plus: 1 -%}
    {%- assign img_url = block.settings.image | image_url: width: 1200 -%}
    {%- assign img_alt = block.settings.alt | default: block.settings.image.alt | default: block.settings.title -%}
    {%- unless first_item -%},{%- endunless -%}
    {
      "src":{{ img_url | json }},
      "alt":{{ img_alt | json }},
      "title":{{ block.settings.title | default: 'Client' | json }},
      "location":{{ block.settings.location | default: '' | json }}
    }
    {%- assign first_item = false -%}
  {%- endif -%}
{%- endfor -%}
]
{%- endcapture -%}

{%- if valid_count == 0 -%}
  <div class="tt-quality__empty">
    <p>Add at least one slide with an image in the theme editor to show Quality Products.</p>
  </div>
{%- else -%}
  <section
    id="tt-quality-{{ section.id }}"
    class="tt-quality{% unless section.settings.enable_autoplay %} tt-quality--no-autoplay{% endunless %}"
    data-tt-quality
    data-autoplay="{% if section.settings.enable_autoplay %}true{% else %}false{% endif %}"
    data-autoplay-ms="{{ section.settings.autoplay_ms }}"
    data-tilt="{{ section.settings.side_tilt }}"
    data-card-gap="{{ section.settings.card_gap }}"
    data-card-max="{{ section.settings.card_max_width }}"
    style="
      --tt-q-bg: {{ section.settings.background_color }};
      --tt-q-gap: {{ section.settings.card_gap }}px;
    "
    aria-roledescription="carousel"
    aria-label="{{ section.settings.accessibility_label | escape }}"
  >
    <script type="application/json" data-tt-quality-slides>
      {{ slides_json }}
    </script>

    <div class="tt-quality__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="tt-quality__heading" data-intro-title>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="tt-quality__body" data-intro-body>{{ section.settings.body | escape }}</p>
      {%- endif -%}
    </div>

    <div
      class="tt-quality__stage"
      data-stage
      tabindex="0"
      role="group"
      aria-label="Product gallery. Drag, click left or right arrows in the ring, or use arrow keys."
    >
      <div class="tt-quality__track" data-track></div>

      <div class="tt-quality__drag-cursor" data-drag-cursor aria-hidden="true">
        <span class="tt-quality__drag-cursor-ring" data-drag-ring></span>
        <span class="tt-quality__drag-cursor-keys">
          <span class="tt-quality__drag-cursor-key" data-key-prev>&lt;</span>
          <span class="tt-quality__drag-cursor-key" data-key-next>&gt;</span>
        </span>
      </div>
    </div>

    <div class="tt-quality__copy" data-copy>
      <h3 class="tt-quality__title" data-title></h3>
      <p class="tt-quality__location" data-location></p>
      <p class="sr-only" data-status aria-live="polite"></p>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
  <script src="{{ 'text-reveal.js' | asset_url }}" defer></script>
  <script src="{{ 'tentwenty-quality.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Quality Products",
  "tag": "section",
  "class": "section-tt-quality",
  "max_blocks": 30,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quality Products"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Supporting text",
      "default": "From our fields to your table — seasonal harvests grown with care, selected for flavour, freshness, and the farms behind them."
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Quality products gallery"
    },
    {
      "type": "header",
      "content": "Playback"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "info": "When off, the hover ring stays a solid inverted circle (no progress fill). Drag and click still work.",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_ms",
      "min": 2500,
      "max": 9000,
      "step": 250,
      "unit": "ms",
      "label": "Autoplay duration per slide",
      "info": "Only used when autoplay is enabled",
      "default": 6500
    },
    {
      "type": "header",
      "content": "Coverflow layout"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Gap between cards",
      "default": 56
    },
    {
      "type": "range",
      "id": "card_max_width",
      "min": 200,
      "max": 420,
      "step": 10,
      "unit": "px",
      "label": "Max card width",
      "default": 340
    },
    {
      "type": "range",
      "id": "side_tilt",
      "min": 0,
      "max": 18,
      "step": 1,
      "unit": "deg",
      "label": "Side card tilt",
      "info": "Tops tilt away from center",
      "default": 10
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f5f5f5"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Client name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location / subtitle",
          "default": "City, Country"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Optional. Falls back to title or image alt."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quality Products",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "title": "Heritage Greens",
            "location": "Dubai, United Arab Emirates"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Flora Delight",
            "location": "Nairobi, Kenya"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Golden Acre",
            "location": "Amsterdam, Netherlands"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Root & Stem",
            "location": "Goa, India"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Open Field",
            "location": "Cape Town, South Africa"
          }
        }
      ]
    }
  ]
}
{% endschema %}
